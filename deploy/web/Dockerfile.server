FROM debian:bookworm-slim
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/elgansayer/Neptune-Bomberman" org.opencontainers.image.revision=$SOURCE_REVISION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libfontconfig1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY build/server/ /app/
RUN chmod +x /app/neptune.x86_64 && mkdir /data && chown 1000:1000 /data
ENV XDG_DATA_HOME=/data HOME=/data XDG_CACHE_HOME=/data/cache
USER 1000:1000
EXPOSE 7777
ENTRYPOINT ["/app/neptune.x86_64", "--headless", "--", "--runtime-role=server", "--transport=websocket", "--server-port=7777"]
