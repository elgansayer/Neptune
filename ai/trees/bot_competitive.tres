[gd_resource type="BehaviorTree" load_steps=48 format=3 uid="uid://chqxceh757yg0"]

[ext_resource type="Script" uid="uid://brcc1oikd2nui" path="res://ai/tasks/conditions/bt_is_in_danger.gd" id="1_danger"]
[ext_resource type="Script" uid="uid://3btukveudf74" path="res://ai/tasks/actions/bt_find_escape_route.gd" id="2_escape"]
[ext_resource type="Script" uid="uid://d1xrs36ub786k" path="res://ai/tasks/actions/bt_move_to_cell.gd" id="3_move"]
[ext_resource type="Script" uid="uid://bx7tlwus8pbtw" path="res://ai/tasks/actions/bt_place_bomb.gd" id="4_bomb"]
[ext_resource type="Script" uid="uid://by34roa2wptm1" path="res://ai/tasks/conditions/bt_has_opponent.gd" id="5_has_opp"]
[ext_resource type="Script" uid="uid://dpcl4vkvplpr" path="res://ai/tasks/actions/bt_find_opponent.gd" id="6_find_opp"]
[ext_resource type="Script" uid="uid://dd2pwn7pbjlje" path="res://ai/tasks/conditions/bt_has_powerup_available.gd" id="7_has_powerup"]
[ext_resource type="Script" uid="uid://d3coarigsg7cj" path="res://ai/tasks/actions/bt_find_powerup.gd" id="8_find_powerup"]
[ext_resource type="Script" uid="uid://dwu6i8josl3h0" path="res://ai/tasks/actions/bt_wait_ambush.gd" id="9_ambush"]
[ext_resource type="Script" uid="uid://c2iemmf5xt4vu" path="res://ai/tasks/actions/bt_find_farming_spot.gd" id="9_tn3ky"]
[ext_resource type="Script" path="res://ai/tasks/actions/bt_set_trap.gd" id="10_trap"]
[ext_resource type="Script" path="res://ai/tasks/actions/bt_predict_opponent.gd" id="11_predict"]
[ext_resource type="Script" path="res://ai/tasks/actions/bt_evade_rubber_bomb.gd" id="12_evade"]
[ext_resource type="Script" path="res://ai/tasks/actions/bt_tactical_assessment.gd" id="13_tac_assess"]
[ext_resource type="Script" path="res://ai/tasks/actions/bt_execute_tactic.gd" id="14_tac_exec"]
[ext_resource type="Script" path="res://ai/tasks/conditions/bt_is_safe_to_attack.gd" id="15_safe_attack"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_bot"]

; === ESCAPE SEQUENCE (Priority 1) ===

[sub_resource type="BTAction" id="BTAction_evade_rubber"]
custom_name = "Evade Rubber Bomb"
script = ExtResource("12_evade")
target_tile_var = &"evade_cell"
detection_radius = 8
urgency_threshold = 2.0

[sub_resource type="BTAction" id="BTAction_evade_move"]
custom_name = "Move Away From Kicked Bomb"
script = ExtResource("3_move")
cell_var = &"evade_cell"
avoid_threats = false

[sub_resource type="BTSequence" id="BTSequence_rubber_escape"]
custom_name = "Rubber Bomb Evasion"
children = [SubResource("BTAction_evade_rubber"), SubResource("BTAction_evade_move")]

[sub_resource type="BTCondition" id="BTCondition_escape_check"]
custom_name = "Check Danger"
script = ExtResource("1_danger")
check_immediate = false

[sub_resource type="BTAction" id="BTAction_escape_find"]
custom_name = "Find Escape Route"
script = ExtResource("2_escape")
escape_radius = 12
target_cell_var = &"escape_cell"

[sub_resource type="BTAction" id="BTAction_escape_move"]
custom_name = "Move To Safe Tile"
script = ExtResource("3_move")
cell_var = &"escape_cell"
avoid_threats = false

[sub_resource type="BTSequence" id="BTSequence_normal_escape"]
custom_name = "Normal Escape"
children = [SubResource("BTCondition_escape_check"), SubResource("BTAction_escape_find"), SubResource("BTAction_escape_move")]

[sub_resource type="BTSelector" id="BTSelector_escape"]
custom_name = "Escape Strategy Selector"
children = [SubResource("BTSequence_rubber_escape"), SubResource("BTSequence_normal_escape")]

; === ATTACK SEQUENCE (Priority 2) ===

[sub_resource type="BTCondition" id="BTCondition_has_opponent"]
custom_name = "Has Opponent?"
script = ExtResource("5_has_opp")
max_distance = 15.0

[sub_resource type="BTCondition" id="BTCondition_safe_to_attack"]
custom_name = "Safe To Attack?"
script = ExtResource("15_safe_attack")
min_escape_routes = 1
safety_time_margin = 1.5

[sub_resource type="BTAction" id="BTAction_tactical_assessment"]
custom_name = "Assess Tactical Situation"
script = ExtResource("13_tac_assess")
assessment_var = &"tactical_plan"
min_safety_margin = 1.5

[sub_resource type="BTAction" id="BTAction_execute_tactic"]
custom_name = "Execute Chosen Tactic"
script = ExtResource("14_tac_exec")
tactic_var = &"tactical_plan"
target_var = &"tactic_target_cell"

[sub_resource type="BTAction" id="BTAction_move_to_tactic_target"]
custom_name = "Move To Tactical Position"
script = ExtResource("3_move")
cell_var = &"tactic_target_cell"
clear_on_success = false

[sub_resource type="BTAction" id="BTAction_place_tactical_bomb"]
custom_name = "Place Tactical Bomb"
script = ExtResource("4_bomb")
require_at_target = true
target_cell_var = &"tactic_target_cell"

[sub_resource type="BTSequence" id="BTSequence_tactical_execution"]
custom_name = "Tactical Execution Sequence"
children = [SubResource("BTAction_execute_tactic"), SubResource("BTAction_move_to_tactic_target"), SubResource("BTAction_place_tactical_bomb")]

[sub_resource type="BTAction" id="BTAction_attack_plan_retreat"]
custom_name = "Plan Retreat"
script = ExtResource("2_escape")
escape_radius = 6
target_cell_var = &"escape_cell"

[sub_resource type="BTAction" id="BTAction_attack_retreat"]
custom_name = "Retreat To Safety"
script = ExtResource("3_move")
cell_var = &"escape_cell"

[sub_resource type="BTSequence" id="BTSequence_attack"]
custom_name = "Tactical Hunt + Kill"
children = [SubResource("BTCondition_has_opponent"), SubResource("BTCondition_safe_to_attack"), SubResource("BTAction_tactical_assessment"), SubResource("BTSequence_tactical_execution"), SubResource("BTAction_attack_plan_retreat"), SubResource("BTAction_attack_retreat")]

; === POWERUP COLLECTION (Priority 3) ===

[sub_resource type="BTCondition" id="BTCondition_has_powerup"]
custom_name = "Has Powerup Available?"
script = ExtResource("7_has_powerup")
max_distance = 15.0

[sub_resource type="BTAction" id="BTAction_find_powerup"]
custom_name = "Find Powerup"
script = ExtResource("8_find_powerup")

[sub_resource type="BTAction" id="BTAction_collect_move"]
custom_name = "Move To Powerup"
script = ExtResource("3_move")

[sub_resource type="BTSequence" id="BTSequence_collect"]
custom_name = "Collect Powerup Sequence"
children = [SubResource("BTCondition_has_powerup"), SubResource("BTAction_find_powerup"), SubResource("BTAction_collect_move")]

; === FARMING (Priority 4) ===

[sub_resource type="BTAction" id="BTAction_find_farming"]
custom_name = "Find Farming Spot"
script = ExtResource("9_tn3ky")
search_radius = 20

[sub_resource type="BTAction" id="BTAction_move_farming"]
custom_name = "Move To Farming Spot"
script = ExtResource("3_move")
cell_var = &"target_cell"
clear_on_success = false
avoid_threats = true

[sub_resource type="BTAction" id="BTAction_place_farming"]
custom_name = "Place Bomb (Farming)"
script = ExtResource("4_bomb")

[sub_resource type="BTAction" id="BTAction_farming_escape_plan"]
custom_name = "Plan Escape After Bomb"
script = ExtResource("2_escape")
target_cell_var = &"escape_cell"

[sub_resource type="BTAction" id="BTAction_farming_escape_move"]
custom_name = "Move To Safety"
script = ExtResource("3_move")
cell_var = &"escape_cell"
avoid_threats = false
clear_on_success = true

[sub_resource type="BTCondition" id="BTCondition_farming_safe"]
custom_name = "Check Safe (Not In Danger)"
script = ExtResource("1_danger")
check_immediate = false

[sub_resource type="BTInvert" id="BTInvert_farming_safe"]
custom_name = "NOT In Danger"
children = [SubResource("BTCondition_farming_safe")]

[sub_resource type="BTSequence" id="BTSequence_farming"]
custom_name = "Farm Blocks Sequence"
children = [SubResource("BTInvert_farming_safe"), SubResource("BTAction_find_farming"), SubResource("BTAction_move_farming"), SubResource("BTAction_place_farming"), SubResource("BTAction_farming_escape_plan"), SubResource("BTAction_farming_escape_move")]

; === AMBUSH (Priority 5 - Fallback) ===

[sub_resource type="BTAction" id="BTAction_ambush"]
custom_name = "Ambush/Patrol"
script = ExtResource("9_ambush")
wait_time = 2.0
prefer_center = false

; === ROOT STRUCTURE ===

[sub_resource type="BTSelector" id="BTSelector_root"]
children = [SubResource("BTSelector_escape"), SubResource("BTSequence_attack"), SubResource("BTSequence_collect"), SubResource("BTSequence_farming"), SubResource("BTAction_ambush")]

[sub_resource type="BTRepeatUntilFailure" id="BTRepeatUntilFailure_loop"]
custom_name = "Continuous Loop"
children = [SubResource("BTSelector_root")]

[resource]
description = "Master Bomberman tactical AI: One-Tile Trap, Choke Points, Space Denial, Predictive Intercept with defensive positioning"
blackboard_plan = SubResource("BlackboardPlan_bot")
root_task = SubResource("BTRepeatUntilFailure_loop")
