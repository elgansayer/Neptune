; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bomberman Client"
run/main_scene="res://client/ui/login_screen.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PCKLoader="*res://scripts/pck_loader.gd"
ClientMain="*res://client/main_client.gd"
ServerMain="*res://main_server.gd"
Constants="*res://shared/constants.gd"
GameConfig="*res://shared/game_config.gd"
LimboConsole="*res://addons/limbo_console/limbo_console.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=1280
window/size/window_height_override=896
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/dpi/allow_hidpi=true

[dotnet]

project/assembly_name="bomberman"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[gdextension]

load_once=PackedStringArray("res://addons/limboai/bin/limboai.gdextension")

[input]

