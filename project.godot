; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bomberman Client"
run/main_scene="res://client/ui/login_screen.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PCKLoader="*res://scripts/pck_loader.gd"
ClientMain="*res://client/main_client.gd"
ServerMain="*res://main_server.gd"
Constants="*res://shared/constants.gd"
GameConfig="*res://shared/game_config.gd"

[dotnet]

project/assembly_name="bomberman"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[gdextension]

load_once=PackedStringArray("res://addons/limboai/bin/limboai.gdextension")

[plugin]

enable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
